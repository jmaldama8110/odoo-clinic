<odoo>

    <record id="loanapp_guarantor_view_tree" model="ir.ui.view">
        <field name="name">loanapp.guarantor.view.tree</field>
        <field name="model">loanapp_guarantor</field>
        <field name="arch" type="xml">
            <tree>
                <field name="contact_id"/>
                <field name="status"/>
                <button name="action_confirm" type="object" icon="fa-check"/>
                <button name="action_cancel" type="object" icon="fa-times"/>

            </tree>
        </field>
    </record>

    <record id="loanapp_guarantor_view_form" model="ir.ui.view">
        <field name="name">loanapp.guarantor.view.form</field>
        <field name="model">loanapp_guarantor</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="contact_id"/>
                    <field name="phone"/>
                    <field name="date_of_verification"/>
                </group>
            </form>
        </field>
    </record>

</odoo>