<odoo>
    <record id="loanapp_application_action" model="ir.actions.act_window">
        <field name="name">Loan Applications</field>
        <field name="res_model">loanapp_application</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_loan_status': True, 'search_default_current': True}</field>
    </record>

    <record id="loanapp_application_view_tree" model="ir.ui.view">
        <field name="name">loanapp.application.view.tree</field>
        <field name="model">loanapp_application</field>
        <field name="arch" type="xml">
            <tree decoration-muted="status=='x' " decoration-success="status == 'c' ">
                <field name="contact_id"/>
                <field name="short_name"/>
                <field name="product_id"/>
                <field name="apply_amount"/>
                <field name="term"/>
                <field name="term_type"/>
                <field name="status"/>
                <button name="action_accept" type="object" icon="fa-check"/>
                <button name="action_cancel" type="object" icon="fa-times"/>
            </tree>
        </field>
    </record>

    <record id="loanapp_application_view_form" model="ir.ui.view">
        <field name="name">loanapp.application.view.form</field>
        <field name="model">loanapp_application</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_accept" type="object" string="Accept" invisible="status !='a'"/>
                    <button name="action_approve" type="object" string="Approve" invisible="status !='b'"/>
                    <button name="action_disburse" type="object" string="Disburse" invisible="status !='c'"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="status not in ['a','b','c']"/>
                    <field name="status" widget="statusbar" statusbar_visible="a,b,c,d"/>
                    </header>
                <sheet>
                    <group>
                        <group>
                            <field name="contact_id"/>

                        </group>
                        <group>
                            <field name="product_id" widget="selection_badge"/>
                        </group>
                        <group>
                            <field name="officer_id"/>
                        </group>
                        <group>
                            <field name="tag_ids" widget="many2many_tags"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Info">
                            <group>
                                <group>
                                    <field name="date_apply"/>
                                    <field name="apply_amount"/>
                                    <field name="term"/>
                                    <field name="term_type"/>
                                    <field name="frequency"/>
                                    <field name="interest_rate"/>
                                </group>

                                <group>
                                    <field name="installment_type"/>
                                    <field name="date_plan_start"/>
                                    <field name="date_plan_end"/>
                                    <field name="installment_amount"/>
                                    <field name="date_disbursement"/>
                                </group>
                            </group>

                        </page>
                        <page string="Evaluation">
                            <group>
                                <group>
                                    <field name="loan_purpose"/>
                                    <field name="main_occupation"/>
                                    <field name="customer_profession"/>
                                    <field name="customer_economic_activity"/>
                                </group>

                            </group>
                            <separator/>
                            <group>
                                <group>
                                    <field name="income_salary"/>
                                    <field name="income_remittances"/>
                                    <field name="income_spouse"/>
                                    <field name="income_others"/>
                                    <field name="total_income"/>
                                </group>
                                <group>
                                    <field name="expenses_rent"/>
                                    <field name="expenses_allowances"/>
                                    <field name="expenses_services"/>
                                    <field name="expenses_others"/>
                                    <field name="total_expenses"/>
                                </group>

                            </group>
                        </page>
                        <page string="Guarantors">
                            <field name="guarantor_ids"/>
                        </page>
                        <page string="Repay plan">
                            <group>
                                <button name="action_calc_loan_scheld" type="object" string="Loan Schedule"/>
                            </group>
                            <group>
                                <field name="loanapp_repay_plan_ids"/>
                            </group>
                        </page>

                    </notebook>
                </sheet>

            </form>
        </field>
    </record>

    <record id="loanapp_application_search" model="ir.ui.view">
        <field name="name">loanapp.application.search</field>
        <field name="model">loanapp_application</field>
        <field name="arch" type="xml">
            <search string="Customer Name">
                <field name="contact_id" string="Client Name" />
                <filter name="loan_status" string="Loan Status" domain="[('status','=','a')]" help="Show only draft loans"/>
            </search>
        </field>
    </record>

</odoo>