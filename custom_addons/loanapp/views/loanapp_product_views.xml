<odoo>
    <record id="loanapp_product_action" model="ir.actions.act_window">
        <field name="name">Loan Products</field>
        <field name="res_model">loanapp_product</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="loanapp_product_view_tree" model="ir.ui.view">
        <field name="name">loanapp.product.view.tree</field>
        <field name="model">loanapp_product</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="short_name"/>
            </tree>
        </field>
    </record>

    <record id="loanapp_producto_view_form" model="ir.ui.view">
        <field name="name">loanapp.product.view.form</field>
        <field name="model">loanapp_product</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <notebook>
                        <page string="Product Generals">
                            <group>
                                <group>
                                    <field name="name"/>
                                    <field name="short_name"/>
                                </group>
                                <group>
                                    <field name="min_amount"/>
                                    <field name="max_amount"/>
                                    <field name="default_amount"/>
                                </group>
                            </group>
                        </page>
                        <page string="Rate">
                            <group>
                                <group>
                                    <field name="min_interest"/>
                                    <field name="max_interest"/>
                                    <field name="default_interest"/>
                                </group>
                            </group>

                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>