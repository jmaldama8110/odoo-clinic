<odoo>
     <record id="loanapp_balance_action" model="ir.actions.act_window">
        <field name="name">Loan Balances</field>
        <field name="res_model">loanapp_balance</field>
        <field name="view_mode">tree</field>
    </record>

    <record id="loanapp_balance_view_tree" model="ir.ui.view">
        <field name="name">loanapp.balance.view.tree</field>
        <field name="model">loanapp_balance</field>
        <field name="arch" type="xml">
            <tree>
                <field name="current_balance"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

</odoo>